{
  "buildCommand": "",
  "outputDirectory": "web",
  "functions": {
    "api/*.py": {
      "runtime": "@vercel/python@4.3.1"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "crons": [
    {
      "path": "/api/send_newsletter",
      "schedule": "0 14 * * *"
    }
  ]
}
