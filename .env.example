# Copy this to .env and fill in your keys
# Never commit .env to git

# The Odds API — get a free key at https://the-odds-api.com/
ODDS_API_KEY=your_key_here

# Resend — https://resend.com/
RESEND_API_KEY=your_key_here
# After verifying chalkiq.com in Resend dashboard:
# RESEND_FROM=ChalkIQ <newsletter@chalkiq.com>
# RESEND_DOMAIN=chalkiq.com

# Neon Postgres (production newsletter + subscribers)
# DATABASE_URL=postgres://...

# Vercel cron auth + site
# CRON_SECRET=...
# SITE_URL=https://chalkiq.com

# Stripe (premium tier)
# STRIPE_SECRET_KEY=...
# STRIPE_PRICE_ID=...

# SMS briefings via email-to-SMS (no Twilio needed)
# Default phone configured for owner; override if needed
SMS_BRIEFING_TO=5128508472
SMS_CARRIER=att
# Or set explicit gateway: SMS_EMAIL=5128508472@txt.att.net

# macOS only: send via iMessage instead of/in addition to email-SMS
# IMESSAGE_BRIEFING=true
